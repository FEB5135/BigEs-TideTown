  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Tsunami.TsunamiController
  simulation: {fileID: 747486362}
  village: {fileID: 180803795}
  mapAdapter: {fileID: 811895068}
  scenarios:
  - name: Vadi Tsunamisi (Oyun)
    description: "Oyunun dalgas\u0131: a\xE7\u0131k denizde b\xFCy\xFCk bir kabarma vadiye y\xF6nelir, da\u011Flar\u0131n aras\u0131ndan ge\xE7ip k\xF6y\xFC vurur."
    amplitude: 10
    lengthRadius: 18
    widthRadius: 70
    offshoreDistance: 100
    directionOffset: 0
    profile: 0
    motion: 1
    bathymetry:
      seaBelowGround: 0.3
      coastSlopeWidth: 24
      shelfDepth: 8
      shelfWidth: 40
      slopeWidth: 40
      deepDepth: 35
      ridgeHeight: 0
      ridgeDistance: 140
  - name: "K\xFC\xE7\xFCk A\xE7\u0131k Deniz Bozulmas\u0131"
    description: "Derin denizde k\xFC\xE7\xFCk, yerel bir kabarma. Durgun ba\u015Flar, her y\xF6ne halkalar halinde yay\u0131l\u0131r; k\u0131y\u0131ya etkisi s\u0131n\u0131rl\u0131d\u0131r."
    amplitude: 2
    lengthRadius: 14
    widthRadius: 14
    offshoreDistance: 120
    directionOffset: 0
    profile: 0
    motion: 0
    bathymetry:
      seaBelowGround: 0.3
      coastSlopeWidth: 24
      shelfDepth: 8
      shelfWidth: 40
      slopeWidth: 40
      deepDepth: 35
      ridgeHeight: 0
      ridgeDistance: 140
  - name: "B\xFCy\xFCk A\xE7\u0131k Deniz Tsunamisi"
    description: "Derin denizde uzun bir fay boyunca b\xFCy\xFCk kabarma. Sahanl\u0131\u011Fa \xE7\u0131k\u0131nca yava\u015Flar ve y\xFCkselir."
    amplitude: 8
    lengthRadius: 16
    widthRadius: 90
    offshoreDistance: 120
    directionOffset: 0
    profile: 0
    motion: 1
    bathymetry:
      seaBelowGround: 0.3
      coastSlopeWidth: 24
      shelfDepth: 8
      shelfWidth: 40
      slopeWidth: 40
      deepDepth: 35
      ridgeHeight: 0
      ridgeDistance: 140
  - name: "S\u0131\u011F K\u0131y\u0131ya Yakla\u015Fma"
    description: "Geni\u015F ve s\u0131\u011F bir sahanl\u0131k. Dalga s\u0131\u011Fla\u015Ft\u0131k\xE7a yava\u015Flar, boyu k\u0131sal\u0131r, y\xFCksekli\u011Fi artar. \xD6nce deniz \xE7ekilir (N-dalgas\u0131)."
    amplitude: 4
    lengthRadius: 14
    widthRadius: 90
    offshoreDistance: 160
    directionOffset: 0
    profile: 1
    motion: 1
    bathymetry:
      seaBelowGround: 0.3
      coastSlopeWidth: 80
      shelfDepth: 5
      shelfWidth: 70
      slopeWidth: 60
      deepDepth: 35
      ridgeHeight: 0
      ridgeDistance: 140
  - name: "K\u0131y\u0131 Ta\u015Fk\u0131n\u0131"
    description: "K\u0131y\u0131ya yak\u0131n g\xFC\xE7l\xFC bir dalga al\xE7ak araziyi basar. Azami ta\u015Fk\u0131n alan\u0131 k\u0131rm\u0131z\u0131yla g\xF6sterilir."
    amplitude: 7
    lengthRadius: 18
    widthRadius: 110
    offshoreDistance: 60
    directionOffset: 0
    profile: 0
    motion: 1
    bathymetry:
      seaBelowGround: 0.3
      coastSlopeWidth: 24
      shelfDepth: 8
      shelfWidth: 40
      slopeWidth: 40
      deepDepth: 35
      ridgeHeight: 0
      ridgeDistance: 140
  - name: "\xD6zel"
    description: "Kendi ayarlar\u0131n: kayna\u011F\u0131 haritada se\xE7, genli\u011Fi, boyutu, y\xF6n\xFC ve deniz taban\u0131n\u0131 de\u011Fi\u015Ftir."
    amplitude: 6
    lengthRadius: 15
    widthRadius: 60
    offshoreDistance: 100
    directionOffset: 0
    profile: 0
    motion: 1
    bathymetry:
      seaBelowGround: 0.3
      coastSlopeWidth: 24
      shelfDepth: 8
      shelfWidth: 40
      slopeWidth: 40
      deepDepth: 35
      ridgeHeight: 0
      ridgeDistance: 140
